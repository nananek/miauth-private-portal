# Copy this file to .env and adjust values for local development. Every
# value below is a dummy default; see docs/operations/configuration.md for
# the full list of keys, defaults, and validation rules.

APP_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
HTTP_SHUTDOWN_GRACE_PERIOD=15s

LOG_LEVEL=info
LOG_FORMAT=text

DB_PATH=./data/portal.db
DB_BUSY_TIMEOUT_MS=5000
DB_MAX_OPEN_CONNS=8

# LOCAL_ORIGIN and IDENTITY_ORIGIN are required in every environment; there
# is no safe default. Scheme+host only, no path/query/userinfo. Must be
# https in production.
LOCAL_ORIGIN=http://localhost:8080
IDENTITY_ORIGIN=https://misskey.example

# Leave ALLOWED_MISSKEY_USER_ID unset to keep this deployment bootstrap-only
# (see cmd/bootstrapctl) until an operator binds it explicitly.
ALLOWED_MISSKEY_USER_ID=

# Comma-separated exact-match allowlist of Aria client return callbacks.
# Commas within one callback's path or query are retained.
# Leave unset to reject any client-supplied callback. A non-HTTPS scheme
# (Aria's own deep link) is explicitly allowed here.
ARIA_CLIENT_CALLBACKS=aria://aria/miauth

UPSTREAM_HTTP_TIMEOUT=10s

OWNER_USERNAME=owner
OWNER_DISPLAY_NAME=
